# Base image: python slim (sử dụng Debian Slim)
FROM python:3.10-slim

# Avoid interactive prompts and keep Python unbuffered
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Set workdir
WORKDIR /app

# Install system packages: ffmpeg (ffprobe đi kèm), build tools (tùy chọn)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ffmpeg \
      ca-certificates \
      gcc \
      build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy only requirements first (cache pip layer)
COPY requirements.txt /app/requirements.txt

# Upgrade pip and install python deps
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r /app/requirements.txt

# Copy toàn bộ source code vào working dir
COPY . /app

# Tạo folder uploads (đảm bảo có quyền ghi)
RUN chown -R root:root /app/uploads

# Expose port
EXPOSE 9001

# Run uvicorn (reload=False cho production; nếu muốn dev dùng reload=True)
CMD ["python", "upload.py"]